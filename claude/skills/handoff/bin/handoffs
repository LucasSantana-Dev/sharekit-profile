#!/usr/bin/env python3
"""handoffs: varios handoffs abertos por repositorio, escolhidos por numero.

  handoffs list            abertos do repo atual, mais novo primeiro
  handoffs path N|trecho   caminho do handoff (N da lista ou trecho do nome)
  handoffs done trecho     arquiva em <projeto>/done/ (nunca por numero: a ordem muda entre sessoes)
  handoffs dir             pasta do projeto (onde o /handoff grava)
  handoffs hook            saida curta para o SessionStart (vazia se nada aberto)

Aberto = <projeto>/*.md com menos de 7 dias (latest.md entra como legado), mais <projeto>/auto/*.md
(snapshots da compactacao, marcados [auto]); done/ fica de fora.
Projeto = pasta do repo principal (worktree resolve para o repo, nao para o worktree).
"""
import re
import subprocess
import sys
import time
from pathlib import Path

BASE = Path.home() / ".claude" / "handoffs"
JANELA_DIAS = 7


def projeto() -> str:
    try:
        comum = subprocess.run(
            ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
        return Path(comum).parent.name
    except (subprocess.CalledProcessError, FileNotFoundError):
        try:
            return Path.cwd().name
        except OSError:
            return "_sem-projeto"


def mtime(p: Path) -> float:
    try:
        return p.stat().st_mtime
    except OSError:  # outra sessao moveu o arquivo no meio da varredura
        return 0.0


def abertos(proj: str) -> list[Path]:
    pasta = BASE / proj
    if not pasta.is_dir():
        return []
    corte = time.time() - JANELA_DIAS * 86400
    achados = [p for p in [*pasta.glob("*.md"), *(pasta / "auto").glob("*.md")] if mtime(p) >= corte]
    return sorted(achados, key=mtime, reverse=True)


def rotulo(p: Path) -> str:
    return "[auto] " if p.parent.name == "auto" else "[legado] " if p.name == "latest.md" else ""


def titulo(p: Path) -> str:
    for linha in p.read_text(errors="replace").splitlines()[:15]:
        if linha.startswith("# "):
            return re.sub(r"\s+", " ", linha[2:]).strip()[:90]
    return p.stem


def idade(p: Path) -> str:
    h = (time.time() - mtime(p)) / 3600
    return f"{h:.0f}h" if h < 48 else f"{h / 24:.0f}d"


def escolher(lista: list[Path], ref: str) -> Path:
    if ref.isdigit() and 1 <= int(ref) <= len(lista):
        return lista[int(ref) - 1]
    casam = [p for p in lista if ref.lower() in p.name.lower()]
    if len(casam) == 1:
        return casam[0]
    sys.exit(f"'{ref}': {'nenhum' if not casam else 'mais de um'} handoff casa. Rode: handoffs list")


def main() -> None:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "list"
    proj = projeto()
    lista = abertos(proj)
    if cmd == "dir":
        print(BASE / proj)
    elif cmd == "list":
        if not lista:
            sys.exit(f"sem handoff aberto em {proj}")
        for i, p in enumerate(lista, 1):
            print(f"{i}) {idade(p):>4}  {rotulo(p)}{p.stem}  |  {titulo(p)}")
    elif cmd == "hook":
        recentes = [p for p in lista if time.time() - mtime(p) < 3 * 86400]
        if recentes:
            print(f"HANDOFFS ABERTOS em {proj} (escolha com /resume N; nao assuma qual e o desta sessao):")
            for i, p in enumerate(recentes[:6], 1):
                print(f"{i}) {rotulo(p)}{p.stem} | {titulo(p)}")
    elif cmd in ("path", "done"):
        if len(sys.argv) < 3:
            sys.exit(f"uso: handoffs {cmd} N|trecho")
        if cmd == "done" and sys.argv[2].isdigit():
            sys.exit("done pede um trecho do nome, nao o numero: outra sessao pode ter reordenado a lista")
        p = escolher(lista, sys.argv[2])
        if cmd == "path":
            print(p)
        else:
            destino = p.parent / "done"
            destino.mkdir(exist_ok=True)
            alvo = destino / p.name
            if alvo.exists():
                alvo = destino / f"{p.stem}-{time.strftime('%H%M%S')}{p.suffix}"
            p.rename(alvo)
            print(f"arquivado: {alvo}")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
